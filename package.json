{
  "name": "chtc-collection-manager",
  "productName": "CHTC Collection Manager",
  "version": "1.0.0",
  "description": "Specimen database for the Coleção Herpetológica Teresa Cristina Sauer de Avila-Pires (CHTC)",
  "main": "main.js",
  "author": "Marcelo José Sturaro <noreply@users.noreply.github.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.unifesp.cururulab.chtc",
    "productName": "CHTC Collection Manager",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "config.js",
      "assets/**",
      "node_modules/jsqr/dist/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSCameraUsageDescription": "The camera is used to scan specimen QR codes."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Science",
      "icon": "build/icon.png",
      "maintainer": "Marcelo José Sturaro <noreply@users.noreply.github.com>"
    },
    "artifactName": "CHTC-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "jsqr": "^1.4.0"
  },
  "homepage": "https://github.com/marcelosturaro"
}